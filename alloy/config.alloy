// Grafana Alloy config: receive syslog and forward to Loki
//
// WS1 sends a non-standard format: <PRI>{...json...}
// Use raw syslog format to accept the message as-is, then parse the JSON body.

logging {
  level  = "warn"
  format = "logfmt"
}

loki.source.syslog "syslog" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "tcp"
    idle_timeout  = "60s"
    labels        = { job = "syslog", service_name = "syslog" }
    syslog_format = "raw"
  }
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    labels        = { job = "syslog", service_name = "syslog" }
    syslog_format = "raw"
  }

  forward_to = [loki.process.parse_ws1.receiver]
}

loki.process "parse_ws1" {
  // WS1 sends two formats:
  //   auditlog:   <PRI>{"time":...}           (no @cee prefix)
  //   accesslog:  <PRI> @cee: {"time":...}    (space + @cee prefix)
  // PRI and @cee prefix are both optional. \s* handles any spacing between them.
  stage.regex {
    expression = `^(?:<\d+>)?\s*(?:@cee:\s*)?(?P<message>\{.+\})\s*$`
  }

  stage.output {
    source = "message"
  }

  // Extract fields from the JSON body.
  // auditlog fields:  category, audit_type, msg_type, server_ip
  // accesslog fields: event_type, status, msg_type, server_ip, device_name, user_name, port_number, device_app
  // alertlog fields:  sub_type, type, msg_type, server_ip, device_name, user_name, hostname, port_number
  stage.json {
    expressions = {
      time             = "time",
      category         = "category",
      msg_type         = "msg_type",
      audit_type       = "audit_type",
      event_type       = "event_type",
      sub_type         = "sub_type",
      status           = "status",
      server_ip        = "server_ip",
      hostname         = "hostname",
      remote_host_name = "remote_host_name",
      user_name        = "user_name",
      port_number      = "port_number",
      device_app       = "device_app",
    }
  }

  // Promote extracted fields to Loki labels.
  stage.labels {
    values = {
      category         = "",
      msg_type         = "",
      audit_type       = "",
      event_type       = "",
      sub_type         = "",
      status           = "",
      server_ip        = "",
      hostname         = "",
      remote_host_name = "",
      user_name        = "",
      port_number      = "",
      device_app       = "",
    }
  }

  // Use the timestamp embedded in the JSON payload.
  // fallback_formats handles milliseconds variant (accesslog uses .524+0800).
  stage.timestamp {
    source           = "time"
    format           = "2006-01-02T15:04:05Z0700"
    fallback_formats = ["2006-01-02T15:04:05.999999999Z0700"]
  }

  // Drop the explicit job label — service_name="syslog" is already set by Alloy from the job value.
  // Drop device_name as it is not needed for log querying.
  stage.label_drop {
    values = ["job", "device_name"]
  }

  forward_to = [loki.write.loki_push.receiver]
}

loki.write "loki_push" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
