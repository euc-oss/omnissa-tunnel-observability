// Grafana Alloy config: receive syslog and forward to Loki
//
// WS1 sends a non-standard format: <PRI>{...json...}
// Use raw syslog format to accept the message as-is, then parse the JSON body.

logging {
  level  = "debug"
  format = "logfmt"
}

loki.source.syslog "syslog" {
  listener {
    address       = "0.0.0.0:514"
    protocol      = "tcp"
    idle_timeout  = "60s"
    labels        = { job = "syslog" }
    syslog_format = "raw"
  }
  listener {
    address       = "0.0.0.0:514"
    protocol      = "udp"
    labels        = { job = "syslog" }
    syslog_format = "raw"
  }

  forward_to = [loki.process.parse_ws1.receiver]
}

loki.process "parse_ws1" {
  // Strip the leading syslog PRI (e.g. "<14>") to expose the raw JSON body.
  stage.regex {
    expression = `^<\d+>(?P<message>\{.+\})\s*$`
  }

  stage.output {
    source = "message"
  }

  // Extract fields from the JSON body.
  stage.json {
    expressions = {
      time       = "time",
      category   = "category",
      msg_type   = "msg_type",
      audit_type = "audit_type",
      server_ip  = "server_ip",
    }
  }

  // Promote extracted fields to Loki labels.
  stage.labels {
    values = {
      category   = "",
      msg_type   = "",
      audit_type = "",
      server_ip  = "",
    }
  }

  // Use the timestamp embedded in the JSON payload.
  stage.timestamp {
    source = "time"
    format = "2006-01-02T15:04:05Z0700"
  }

  forward_to = [loki.write.loki_push.receiver]
}

loki.write "loki_push" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
